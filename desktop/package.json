{
  "name": "nanxi-desktop-shell",
  "version": "1.0.0",
  "private": true,
  "description": "南溪AI获客 桌面壳：Electron BrowserView 嵌抖音创作页/消息页，界面与数据来自本机桥接服务 (127.0.0.1:8899)",
  "author": "Nanxi AI",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "offline": "electron offline-test.js",
    "capture": "electron . --capture",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nanxi.lead-desktop",
    "productName": "南溪AI获客",
    "copyright": "Copyright © 2026 Nanxi AI",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "external-url.js",
      "douyin_agent.js",
      "command-control.js",
      "live-preview.js",
      "worker-surface.js",
      "video-focus.js",
      "live-dashboard.js",
      "write-commands.js",
      "action-executor.js",
      "interaction-dom.js",
      "live-platform.js",
      "comment-like.js",
      "comment-like-launcher.js",
      "leadgen-launcher.js",
      "leadgen-read.js",
      "leadgen-review.js",
      "live-dm.js",
      "leadgen-extensions.js",
      "live-social.js",
      "live-media.js",
      "live-comment-extras.js",
      "profile-qr.js",
      "offline-test.js",
      "_verify/offline_action_driver.js",
      "_verify/offline_dom_fixture.js",
      "session-partition.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "南溪AI获客",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "installerHeaderIcon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
